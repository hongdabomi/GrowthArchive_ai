# Same OpenAI provider and default model as the frontend reference repository.
# Keep real keys in the local .env file, never in this example.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=45
AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://1-line-frontend.vercel.app

# The deployed backend base includes /api; override this per environment if its address changes.
BACKEND_INTERNAL_BASE_URL=https://43-200-160-203.sslip.io/api
# Use the same secret value on the AI and backend servers.
INTERNAL_SERVICE_TOKEN=
