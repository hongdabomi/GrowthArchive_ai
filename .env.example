# Same OpenAI provider and default model as the frontend reference repository.
# Keep real keys in the local .env file, never in this example.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=45
AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Include /api in the internal base, for example http://127.0.0.1:3001/api.
BACKEND_INTERNAL_BASE_URL=
INTERNAL_SERVICE_TOKEN=
